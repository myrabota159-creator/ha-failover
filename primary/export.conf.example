# Settings for export.sh on the primary. Copy to export.conf in the same folder.
# One setting per line: <key> <value>. Lines starting with # are ignored.

# Readiness checks used by "return to primary": the return succeeds only when core is RUNNING
# and every check matches. Form: check <entity_id>=<expected state>, or "check zha" for the ZHA integration.
#check binary_sensor.zigbee2mqtt_bridge_connection_state=on
#check zha

# Notify services (without "notify.") for the "back on the primary" push.
#notify mobile_app_my_phone

# Language of that push: en or ru.
language en
